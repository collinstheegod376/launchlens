# LaunchLens Environment Configuration

# Public Base URL (for sharing and Telegram bot report links)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Solana RPC Endpoint (Free Tier / Public)
# Leave empty or default to public Solana RPC https://api.mainnet-beta.solana.com
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# Groq API Key (Ultra-fast free tier with Llama 3.3 70B from https://console.groq.com)
GROQ_API_KEY=

# Google Gemini API Key (Free tier from Google AI Studio)
# Optional: if omitted and GROQ_API_KEY is omitted, LaunchLens uses deterministic rule summary
GEMINI_API_KEY=

# Telegram Bot Token (from @BotFather)
# Required only if running the Telegram Bot
TELEGRAM_BOT_TOKEN=

# Supabase Postgres (Free Tier)
# Optional: used for persistent snapshot storage and report history
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
